{
  "name": "coursewright",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @coursewright/bff --filter @coursewright/web run dev",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "build": "pnpm -r --if-present run build",
    "e2e": "pnpm --filter @coursewright/web run e2e",
    "contracts:generate": "pnpm --filter @coursewright/contracts run generate",
    "contracts:check": "pnpm contracts:generate && git diff --exit-code -- contracts/"
  }
}
